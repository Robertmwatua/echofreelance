# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=echofreelance_dev
DATABASE_URL=postgresql://postgres:postgrespassword@db:5432/echofreelance_dev
# Neon: set DIRECT_URL to the non-pooler connection (host without -pooler)
DIRECT_URL=postgresql://postgres:postgrespassword@db:5432/echofreelance_dev

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000

# JWT / Auth
JWT_SECRET=change_me_to_a_strong_secret

# 8x8 Jitsi as a Service (live classroom)
# 8x8 JaaS — required for live Start now (Render API env)
JAAS_APP_ID=vpaas-magic-cookie-xxxxxxxx
JAAS_API_KEY_ID=vpaas-magic-cookie-xxxxxxxx/uuid
# One line on Render: newlines as \n inside quotes
JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

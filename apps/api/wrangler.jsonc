{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "echofreelance-api",
  "main": "dist-worker/worker.mjs",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_server_modules"
  ],
  "vars": {
    "NODE_ENV": "production",
    "CLOUDFLARE_WORKER": "true",
    "TRUST_PROXY_HOPS": "1"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "no_bundle": true,
  "workers_dev": false,
  "preview_urls": false
}

DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/echofreelance_dev
# Same as DATABASE_URL locally; on Neon use the non-pooler "direct" connection string
DIRECT_URL=postgresql://postgres:postgrespassword@localhost:5432/echofreelance_dev
JWT_SECRET=change_me_to_a_strong_secret
PORT=4000
# 8x8 Jitsi as a Service — required for Start now / live rooms
# From https://jaas.8x8.vc → API keys
JAAS_APP_ID=vpaas-magic-cookie-xxxxxxxx
JAAS_API_KEY_ID=vpaas-magic-cookie-xxxxxxxx/00000000-0000-0000-0000-000000000000
# Full PEM on one line for Render: replace real newlines with \n
JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"

# MegaPay Linked Accounts → General (server only; never NEXT_PUBLIC_*)
MEGAPAY_API_KEY=
# Email used to sign in to the school's MegaPay account
MEGAPAY_EMAIL=

# Google Identity Services web client ID (Google Cloud OAuth, no secret needed for ID-token verification)
GOOGLE_CLIENT_ID=
# Authorized JavaScript origins: https://www.echofreelancetechschool.com and https://echofreelancetechschool.com
# Password-reset email: use the school's SMTP provider credentials, never normal passwords in source.
WEB_URL=https://www.echofreelancetechschool.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Server-only WhatsApp invitation; leave blank until the school provides it.
STUDENT_WHATSAPP_GROUP_URL=

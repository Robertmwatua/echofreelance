DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/echofreelance_dev
# Same as DATABASE_URL locally; on Neon use the non-pooler "direct" connection string
DIRECT_URL=postgresql://postgres:postgrespassword@localhost:5432/echofreelance_dev
JWT_SECRET=change_me_to_a_strong_secret
PORT=4000
# 8x8 Jitsi as a Service — required for Start now / live rooms
# From https://jaas.8x8.vc → API keys
JAAS_APP_ID=vpaas-magic-cookie-xxxxxxxx
JAAS_API_KEY_ID=vpaas-magic-cookie-xxxxxxxx/00000000-0000-0000-0000-000000000000
# Full PEM on one line for Render: replace real newlines with \n
JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
